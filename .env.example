# No environment keys are required for the working demo storefront.
# For live catalog, authentication, inventory and orders:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set BOTH for real Razorpay checkout; signature checks and webhooks require the secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional for contact form notifications (not enabled in demo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
